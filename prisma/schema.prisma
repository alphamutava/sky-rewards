generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================== ENUMS ========================

enum UserRole {
  VIEWER
  CREATOR
  ADVERTISER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum CampaignType {
  VIDEO
  PHOTO
  ARTICLE
  MIXED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  FLAGGED
  REVISION_REQUESTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  CAMPAIGN_FUND
  CREATOR_PAYOUT
  VIEW_REWARD
  PLATFORM_COMMISSION
  ELITE_BONUS
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

enum PaymentMethod {
  MPESA_STK
  MPESA_B2C
  WALLET
  BANK_TRANSFER
}

enum NotificationType {
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  PAYMENT_RECEIVED
  PAYOUT_SENT
  CAMPAIGN_FUNDED
  CAMPAIGN_EXPIRED
  ELITE_PROMOTED
  ELITE_DEMOTED
  SYSTEM
}

// ======================== USER ========================

model User {
  id                String           @id @default(cuid())
  email             String?          @unique
  phone             String           @unique
  phoneVerified     Boolean          @default(false)
  passwordHash      String
  firstName         String
  lastName          String
  displayName       String?
  avatar            String?
  bio               String?
  role              UserRole         @default(VIEWER)
  status            UserStatus       @default(PENDING_VERIFICATION)
  county            String?
  city              String?
  dateOfBirth       DateTime?
  nationalId        String?          @unique
  
  // Wallet
  walletBalance     Decimal          @default(0) @db.Decimal(12, 2)
  totalEarned       Decimal          @default(0) @db.Decimal(12, 2)
  totalWithdrawn    Decimal          @default(0) @db.Decimal(12, 2)
  
  // Elite
  isElite           Boolean          @default(false)
  eliteRank         Int?
  eliteJoinedAt     DateTime?
  eliteScore        Decimal          @default(0) @db.Decimal(10, 2)
  
  // Tracking
  totalViews        Int              @default(0)
  totalSubmissions  Int              @default(0)
  totalApproved     Int              @default(0)
  averageRating     Decimal          @default(0) @db.Decimal(3, 2)
  
  // Auth
  otpCode           String?
  otpExpiresAt      DateTime?
  lastLoginAt       DateTime?
  loginAttempts     Int              @default(0)
  lockedUntil       DateTime?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relations
  campaigns         Campaign[]       @relation("AdvertiserCampaigns")
  submissions       Submission[]
  transactions      Transaction[]
  viewsAsViewer     View[]
  notifications     Notification[]
  sentReviews       Review[]
  
  @@index([phone])
  @@index([email])
  @@index([role, status])
  @@index([isElite, eliteRank])
  @@map("users")
}

// ======================== CAMPAIGN ========================

model Campaign {
  id                String           @id @default(cuid())
  title             String
  slug              String           @unique
  description       String
  brief             String           @db.Text
  type              CampaignType
  status            CampaignStatus   @default(DRAFT)
  
  // Budget
  totalBudget       Decimal          @db.Decimal(12, 2)
  remainingBudget   Decimal          @db.Decimal(12, 2)
  platformFee       Decimal          @db.Decimal(12, 2)
  rewardPerView     Decimal          @default(0.50) @db.Decimal(8, 2)
  creatorReward     Decimal          @db.Decimal(10, 2)
  maxSubmissions    Int              @default(50)
  maxViewsPerSubmission Int          @default(10000)
  
  // Targeting
  targetCounty      String?
  targetAgeMin      Int?
  targetAgeMax      Int?
  targetGender      String?
  tags              String[]
  
  // Media
  coverImage        String?
  guidelines        String?          @db.Text
  sampleMedia       String[]
  
  // Dates
  startDate         DateTime
  endDate           DateTime
  
  // Advertiser
  advertiserId      String
  advertiser        User             @relation("AdvertiserCampaigns", fields: [advertiserId], references: [id])
  
  // Stats
  totalSubmissions  Int              @default(0)
  approvedSubmissions Int            @default(0)
  totalViews        Int              @default(0)
  totalSpent        Decimal          @default(0) @db.Decimal(12, 2)
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relations
  submissions       Submission[]
  transactions      Transaction[]
  
  @@index([status, startDate, endDate])
  @@index([advertiserId])
  @@index([slug])
  @@index([type, status])
  @@map("campaigns")
}

// ======================== SUBMISSION ========================

model Submission {
  id                String           @id @default(cuid())
  
  // Content
  title             String
  description       String?
  mediaUrl          String
  mediaType         String
  thumbnailUrl      String?
  duration          Int?
  fileSize          Int?
  
  // Status
  status            SubmissionStatus @default(PENDING)
  rejectionReason   String?
  revisionNotes     String?
  qualityScore      Decimal?         @db.Decimal(3, 2)
  
  // Stats
  viewCount         Int              @default(0)
  uniqueViewers     Int              @default(0)
  totalEarned       Decimal          @default(0) @db.Decimal(12, 2)
  creatorEarned     Decimal          @default(0) @db.Decimal(12, 2)
  
  // Relations
  creatorId         String
  creator           User             @relation(fields: [creatorId], references: [id])
  campaignId        String
  campaign          Campaign         @relation(fields: [campaignId], references: [id])
  views             View[]
  reviews           Review[]
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@unique([creatorId, campaignId])
  @@index([status])
  @@index([campaignId, status])
  @@index([creatorId])
  @@map("submissions")
}

// ======================== REVIEW ========================

model Review {
  id                String           @id @default(cuid())
  
  submissionId      String
  submission        Submission       @relation(fields: [submissionId], references: [id])
  reviewerId        String
  reviewer          User             @relation(fields: [reviewerId], references: [id])
  
  decision          SubmissionStatus
  qualityScore      Decimal?         @db.Decimal(3, 2)
  feedback          String?
  
  createdAt         DateTime         @default(now())
  
  @@index([submissionId])
  @@map("reviews")
}

// ======================== VIEW ========================

model View {
  id                String           @id @default(cuid())
  
  submissionId      String
  submission        Submission       @relation(fields: [submissionId], references: [id])
  viewerId          String
  viewer            User             @relation(fields: [viewerId], references: [id])
  
  // Tracking
  watchDuration     Int              @default(0)
  completionPercent Decimal          @default(0) @db.Decimal(5, 2)
  earned            Decimal          @default(0) @db.Decimal(8, 2)
  ipAddress         String?
  userAgent         String?
  
  // Anti-fraud
  isValid           Boolean          @default(true)
  flagReason        String?
  
  createdAt         DateTime         @default(now())
  
  @@unique([submissionId, viewerId])
  @@index([viewerId, createdAt])
  @@index([submissionId])
  @@map("views")
}

// ======================== TRANSACTION ========================

model Transaction {
  id                String            @id @default(cuid())
  
  // Reference
  referenceCode     String            @unique
  mpesaReceiptNo    String?           @unique
  mpesaRequestId    String?
  
  // Details
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  method            PaymentMethod
  amount            Decimal           @db.Decimal(12, 2)
  fee               Decimal           @default(0) @db.Decimal(10, 2)
  netAmount         Decimal           @db.Decimal(12, 2)
  
  // Parties
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  campaignId        String?
  campaign          Campaign?         @relation(fields: [campaignId], references: [id])
  
  // M-Pesa details
  phoneNumber       String?
  accountReference  String?
  transactionDesc   String?
  
  // Status tracking
  failureReason     String?
  completedAt       DateTime?
  metadata          Json?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([userId, type])
  @@index([status])
  @@index([referenceCode])
  @@index([mpesaReceiptNo])
  @@index([campaignId])
  @@map("transactions")
}

// ======================== NOTIFICATION ========================

model Notification {
  id                String           @id @default(cuid())
  
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  
  type              NotificationType
  title             String
  message           String
  data              Json?
  read              Boolean          @default(false)
  readAt            DateTime?
  
  createdAt         DateTime         @default(now())
  
  @@index([userId, read])
  @@map("notifications")
}

// ======================== SYSTEM SETTINGS ========================

model SystemSetting {
  id                String           @id @default(cuid())
  key               String           @unique
  value             String
  description       String?
  updatedAt         DateTime         @updatedAt
  
  @@map("system_settings")
}

// ======================== AUDIT LOG ========================

model AuditLog {
  id                String           @id @default(cuid())
  
  action            String
  entity            String
  entityId          String
  userId            String?
  oldValue          Json?
  newValue          Json?
  ipAddress         String?
  
  createdAt         DateTime         @default(now())
  
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
