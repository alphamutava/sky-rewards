generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ======================== USER ========================

model User {
  id                String           @id @default(cuid())
  email             String?          @unique
  phone             String?          @unique
  phoneVerified     Boolean          @default(false)
  passwordHash      String
  firstName         String?
  lastName          String?
  displayName       String?
  avatar            String?
  bio               String?
  role              String           @default("VIEWER")
  status            String           @default("PENDING_VERIFICATION")
  county            String?
  city              String?
  dateOfBirth       DateTime?
  nationalId        String?          @unique
  
  // Wallet
  walletBalance     Decimal          @default(0)
  totalEarned       Decimal          @default(0)
  totalWithdrawn    Decimal          @default(0)
  
  // Elite
  isElite           Boolean          @default(false)
  eliteRank         Int?
  eliteJoinedAt     DateTime?
  eliteScore        Decimal          @default(0)
  
  // Tracking
  totalViews        Int              @default(0)
  totalSubmissions  Int              @default(0)
  totalApproved     Int              @default(0)
  averageRating     Decimal          @default(0)
  
  // Auth
  otpCode           String?
  otpExpiresAt      DateTime?
  lastLoginAt       DateTime?
  loginAttempts     Int              @default(0)
  lockedUntil       DateTime?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relations
  campaigns         Campaign[]       @relation("AdvertiserCampaigns")
  submissions       Submission[]
  transactions      Transaction[]
  viewsAsViewer     View[]
  notifications     Notification[]
  sentReviews       Review[]
  
  @@index([phone])
  @@index([email])
  @@index([role, status])
  @@index([isElite, eliteRank])
  @@map("users")
}

// ======================== CAMPAIGN ========================

model Campaign {
  id                String           @id @default(cuid())
  title             String
  slug              String           @unique
  description       String
  brief             String
  type              String
  status            String           @default("DRAFT")
  
  // Budget
  totalBudget       Decimal
  remainingBudget   Decimal
  platformFee       Decimal
  rewardPerView     Decimal          @default(0.50)
  creatorReward     Decimal
  maxSubmissions    Int              @default(50)
  maxViewsPerSubmission Int          @default(10000)
  
  // Targeting
  targetCounty      String?
  targetAgeMin      Int?
  targetAgeMax      Int?
  targetGender      String?
  tags              Json             @default("[]")
  
  // Media
  coverImage        String?
  guidelines        String?
  sampleMedia       Json             @default("[]")
  
  // Dates
  startDate         DateTime
  endDate           DateTime
  
  // Advertiser
  advertiserId      String
  advertiser        User             @relation("AdvertiserCampaigns", fields: [advertiserId], references: [id])
  
  // Stats
  totalSubmissions  Int              @default(0)
  approvedSubmissions Int            @default(0)
  totalViews        Int              @default(0)
  totalSpent        Decimal          @default(0)
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relations
  submissions       Submission[]
  transactions      Transaction[]
  
  @@index([status, startDate, endDate])
  @@index([advertiserId])
  @@index([slug])
  @@index([type, status])
  @@map("campaigns")
}

// ======================== SUBMISSION ========================

model Submission {
  id                String           @id @default(cuid())
  
  // Content
  title             String
  description       String?
  mediaUrl          String
  mediaType         String
  thumbnailUrl      String?
  duration          Int?
  fileSize          Int?
  
  // Status
  status            String           @default("PENDING")
  rejectionReason   String?
  revisionNotes     String?
  qualityScore      Decimal?
  
  // Stats
  viewCount         Int              @default(0)
  uniqueViewers     Int              @default(0)
  totalEarned       Decimal          @default(0)
  creatorEarned     Decimal          @default(0)
  
  // Relations
  creatorId         String
  creator           User             @relation(fields: [creatorId], references: [id])
  campaignId        String
  campaign          Campaign         @relation(fields: [campaignId], references: [id])
  views             View[]
  reviews           Review[]
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@unique([creatorId, campaignId])
  @@index([status])
  @@index([campaignId, status])
  @@index([creatorId])
  @@map("submissions")
}

// ======================== REVIEW ========================

model Review {
  id                String           @id @default(cuid())
  
  submissionId      String
  submission        Submission       @relation(fields: [submissionId], references: [id])
  reviewerId        String
  reviewer          User             @relation(fields: [reviewerId], references: [id])
  
  decision          String
  qualityScore      Decimal?
  feedback          String?
  
  createdAt         DateTime         @default(now())
  
  @@index([submissionId])
  @@index([reviewerId])
  @@map("reviews")
}

// ======================== VIEW ========================

model View {
  id                String           @id @default(cuid())
  
  submissionId      String
  submission        Submission       @relation(fields: [submissionId], references: [id])
  viewerId          String
  viewer            User             @relation(fields: [viewerId], references: [id])
  
  // Tracking
  watchDuration     Int              @default(0)
  completionPercent Decimal          @default(0)
  earned            Decimal          @default(0)
  ipAddress         String?
  userAgent         String?
  
  // Anti-fraud
  isValid           Boolean          @default(true)
  flagReason        String?
  
  createdAt         DateTime         @default(now())
  
  @@unique([submissionId, viewerId])
  @@index([viewerId, createdAt])
  @@index([submissionId])
  @@index([ipAddress, createdAt])
  @@map("views")
}

// ======================== TRANSACTION ========================

model Transaction {
  id                String            @id @default(cuid())
  
  // Reference
  referenceCode     String            @unique
  mpesaReceiptNo    String?           @unique
  mpesaRequestId    String?
  
  // Details
  type              String
  status            String            @default("PENDING")
  method            String
  amount            Decimal
  fee               Decimal           @default(0)
  netAmount         Decimal
  
  // Parties
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  campaignId        String?
  campaign          Campaign?         @relation(fields: [campaignId], references: [id])
  
  // M-Pesa details
  phoneNumber       String?
  accountReference  String?
  transactionDesc   String?
  
  // Status tracking
  failureReason     String?
  completedAt       DateTime?
  metadata          Json?            @default("{}")
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([userId, type])
  @@index([status])
  @@index([status, type, method])
  @@index([referenceCode])
  @@index([mpesaReceiptNo])
  @@index([mpesaRequestId])
  @@index([campaignId])
  @@map("transactions")
}

// ======================== NOTIFICATION ========================

model Notification {
  id                String           @id @default(cuid())
  
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  
  type              String
  title             String
  message           String
  data              Json?            @default("{}")
  read              Boolean          @default(false)
  readAt            DateTime?
  
  createdAt         DateTime         @default(now())
  
  @@index([userId, read])
  @@map("notifications")
}

// ======================== SYSTEM SETTINGS ========================

model SystemSetting {
  id                String           @id @default(cuid())
  key               String           @unique
  value             String
  description       String?
  updatedAt         DateTime         @updatedAt
  
  @@map("system_settings")
}

// ======================== AUDIT LOG ========================

model AuditLog {
  id                String           @id @default(cuid())
  
  action            String
  entity            String
  entityId          String
  userId            String?
  oldValue          Json?
  newValue          Json?
  ipAddress         String?
  
  createdAt         DateTime         @default(now())
  
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
