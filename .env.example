# Database
DATABASE_URL="postgresql://user:password@localhost:5432/skykenya?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-64-char-random-string-here"

# M-Pesa Daraja API (Safaricom)
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_PASSKEY="your-lipa-na-mpesa-passkey"
MPESA_SHORTCODE="174379"
MPESA_B2C_SHORTCODE="your-b2c-shortcode"
MPESA_B2C_INITIATOR="your-initiator-name"
MPESA_B2C_PASSWORD="your-initiator-password"
MPESA_B2C_SECURITY_CREDENTIAL="your-encrypted-credential"
MPESA_ENVIRONMENT="sandbox"
MPESA_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/callback"
MPESA_B2C_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/b2c-callback"
MPESA_B2C_TIMEOUT_URL="https://yourdomain.com/api/payments/mpesa/b2c-timeout"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Redis (Upstash)
REDIS_URL="redis://default:password@hostname:port"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Africa's Talking (SMS/OTP)
AT_API_KEY="your-africastalking-api-key"
AT_USERNAME="your-username"
AT_SENDER_ID="SKYKENYA"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@skykenya.co.ke"

# Platform Config
PLATFORM_COMMISSION_PERCENT="15"
MIN_WITHDRAWAL_KES="100"
MAX_WITHDRAWAL_KES="150000"
VIEW_REWARD_KES="0.50"
CREATOR_REWARD_PERCENT="70"
ELITE_BONUS_MULTIPLIER="1.5"
MAX_DAILY_VIEW_EARNINGS_KES="500"

# Cron Secret
CRON_SECRET="generate-a-random-64-char-string"
