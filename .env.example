DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ======================== NEXTAUTH ========================
# Generate securely via `openssl rand -base64 32`
NEXTAUTH_SECRET="replace_with_secure_random_string_in_production"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# ======================== SECURITY ========================
# Master key for PII AES-256-GCM encryption. Must be exactly 32 bytes (64 hex chars).
# Generate via `openssl rand -hex 32`
ENCRYPTION_KEY="replace_with_64_character_hex_string_in_production"

# ======================== REDIS / CACHE ========================
# Standard Redis connection (for BullMQ background jobs)
REDIS_URL="redis://localhost:6379"

# Upstash REST API (for Edge middleware rate limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace_with_upstash_token"

# ======================== M-PESA DARAJA ========================
MPESA_ENVIRONMENT="sandbox" # Use 'production' for live
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_BASE_URL="https://your-domain.com"
MPESA_CALLBACK_SECRET="replace_with_secure_webhook_secret"

# M-Pesa B2C (payouts)
MPESA_B2C_SHORTCODE=""
MPESA_B2C_INITIATOR_NAME=""
MPESA_B2C_SECURITY_CREDENTIAL=""

# Safaricom IP allowlist (comma-separated, for production)
MPESA_ALLOWED_IPS="196.201.214.200,196.201.214.206,196.201.213.114"

# ======================== SMS (Africa's Talking) ========================
AT_USERNAME="sandbox"
AT_API_KEY=""
AT_SENDER_ID="SKYKENYA"

# ======================== EMAIL (Resend) ========================
RESEND_API_KEY=""
EMAIL_FROM="noreply@skykenya.co.ke"

# ======================== FILE UPLOAD (Cloudinary) ========================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ======================== PLATFORM CONFIG ========================
PLATFORM_COMMISSION_PERCENT="15"
MIN_WITHDRAWAL_KES="100"
MAX_WITHDRAWAL_KES="150000"
MAX_DAILY_VIEW_EARNINGS_KES="500"
ELITE_BONUS_MULTIPLIER="1.5"

# ======================== WORKER / CRON ========================
CRON_SECRET=""
